cabal-version:      3.0
name:               st-linear
version:            0.1.0.0
license:            MIT
license-file:       LICENSE
author:             Satoshi Nakamura
maintainer:         snak@snak.org
-- copyright:
build-type:         Simple
-- extra-source-files:

common warnings
    ghc-options: -Wall -Wno-name-shadowing

executable st-linear
    import:           warnings
    main-is:          Main.hs
    other-modules:    Linear
                      ST
    default-extensions: LinearTypes
    build-depends:    base ^>=4.22.0.0,
                      linear-base,
                      vector
    default-language: GHC2024
